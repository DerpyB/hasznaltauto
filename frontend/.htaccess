<IfModule mod_rewrite.c>
RewriteEngine On

# Send API requests to Laravel backend
RewriteRule ^api/(.*)$ /backend/public/index.php/api/$1 [QSA,L]

# Serve existing files normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise load Vue SPA
RewriteRule ^ index.html [L]
</IfModule>